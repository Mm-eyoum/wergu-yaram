# Functions params (non secrets) — copier en functions/.env
BICTORYS_API_URL=https://api.bictorys.com
APP_PUBLIC_URL=https://werguyaram.org

# --- Chatwoot (support omnicanal, auto-hébergé) ---
# URL de votre instance (sans slash final), identifiant de compte et de l'inbox
# Website. Utilisés par le push API (formulaires → contacts/conversations).
CHATWOOT_BASE_URL=https://chat.werguyaram.org
CHATWOOT_ACCOUNT_ID=
CHATWOOT_WEBSITE_INBOX_ID=

# --- Email transactionnel (Brevo) ---
# Expéditeur au format "Nom <email>". Le domaine doit être validé (SPF/DKIM) dans Brevo.
BREVO_SENDER=Wergu Yaram <no-reply@werguyaram.org>

# Secrets — NE PAS mettre ici. Les définir via Secret Manager :
#   firebase functions:secrets:set BICTORYS_API_KEY
#   firebase functions:secrets:set BICTORYS_WEBHOOK_SECRET
#   firebase functions:secrets:set CHATWOOT_HMAC_TOKEN     # Inbox Website → Configuration → HMAC
#   firebase functions:secrets:set CHATWOOT_API_TOKEN      # Profil → Access Token (agent/bot)
#   firebase functions:secrets:set CHATWOOT_WEBHOOK_TOKEN  # jeton partagé que vous choisissez (URL du webhook)
#   firebase functions:secrets:set BREVO_API_KEY           # Brevo → SMTP & API → clé API v3
