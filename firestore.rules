rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isSuperAdmin() {
      return hasProfile() && userDoc().role == 'super_admin';
    }
    // Admin powers are granted to both 'admin' and 'super_admin'.
    function isAdmin() {
      return hasProfile() && userDoc().role in ['admin', 'super_admin'];
    }
    // Content-staff powers: 'editor' manages editorial content (medications,
    // articles, …) via the admin CMS but not users, roles or settings.
    // Admins and super_admins also satisfy this.
    function isEditor() {
      return hasProfile() && userDoc().role in ['editor', 'admin', 'super_admin'];
    }
    // An account in good standing (not suspended) may contribute content.
    function isActiveUser() {
      return hasProfile() && userDoc().status == 'active';
    }

    // A required free-text field: a string within [min, max] characters.
    // Guards against oversized documents (cost/DoS) and empty submissions.
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Guards which role transitions an admin may perform on a user profile.
    function roleChangeAuthorized(uid, oldRole, newRole) {
      return
        // No role change → a plain admin may still update other fields (e.g. status).
        (oldRole == newRole && isAdmin())
        // Role change → never on one's own account.
        || (oldRole != newRole && request.auth.uid != uid && (
             // Super_admin grants/revokes 'admin', but never 'super_admin'.
             (isSuperAdmin() && oldRole != 'super_admin' && newRole != 'super_admin')
             // Admin toggles patient_public ↔ health_pro ↔ editor (no privilege escalation;
             // health_pro is a patient-level verified badge, not an admin power).
             || (isAdmin()
                 && oldRole in ['patient_public', 'health_pro', 'editor']
                 && newRole in ['patient_public', 'health_pro', 'editor'])
           ));
    }

    // --- User profiles ---
    // A user reads/writes only their own profile. Admins read all.
    // Self-signup is always a patient_public; role/status are locked after
    // creation so a user can never self-promote or self-validate.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.role == 'patient_public'
        && request.resource.data.status == 'active'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120;

      // Owner may edit profile fields but NOT role/status.
      // Admins change status (e.g. suspend) and toggle patient_public ↔ editor;
      // only a super_admin may grant/revoke 'admin'. No actor can create or demote
      // a 'super_admin', and no admin may change their own role (see
      // roleChangeAuthorized).
      allow update: if
        (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status)
        || (isAdmin()
          && roleChangeAuthorized(uid, resource.data.role, request.resource.data.role));

      allow delete: if isSuperAdmin();
    }

    // --- Public verified content (read-only for clients) ---
    // Writes go through the admin CMS: editors + admins may manage content.
    match /medications/{doc}    { allow read: if true; allow write: if isEditor(); }
    match /pathologies/{doc}    { allow read: if true; allow write: if isEditor(); }
    match /articles/{doc}       { allow read: if true; allow write: if isEditor(); }
    // Facilities are THE single model for a health establishment. An editor
    // manages editorial entries; an active user may also create one they own
    // (source:"user"), and a claimed directory listing carries an `ownerUid`.
    // Owners edit content fields only — they can never publish/verify, change
    // owner/slug/source/claimStatus, nor grant themselves a paid tier
    // (monetization fields are written by the subscription webhook). Admin
    // validation gates public visibility.
    match /facilities/{slug} {
      function facOwner() { return resource.data.get('ownerUid', ''); }
      allow read: if true;
      allow create: if isEditor()
        || (isActiveUser()
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.get('published', false) == false
            && request.resource.data.get('verified', false) == false
            && request.resource.data.get('source', '') == 'user'
            && request.resource.data.slug == slug
            && isText(request.resource.data.name, 2, 150));
      allow delete: if isEditor();
      allow update: if isEditor()
        || (isSignedIn()
            && facOwner() != ''
            && request.auth.uid == facOwner()
            && request.resource.data.get('ownerUid', '') == facOwner()
            && request.resource.data.get('slug', '') == resource.data.get('slug', '')
            && request.resource.data.get('published', false) == false
            && request.resource.data.get('verified', false) == false
            && request.resource.data.get('source', '') == resource.data.get('source', '')
            && request.resource.data.get('claimStatus', '') == resource.data.get('claimStatus', '')
            && request.resource.data.get('planTier', '') == resource.data.get('planTier', '')
            && request.resource.data.get('planId', '') == resource.data.get('planId', '')
            && request.resource.data.get('featured', false) == resource.data.get('featured', false)
            && request.resource.data.get('subscribedUntil', '') == resource.data.get('subscribedUntil', ''));
    }
    match /partners/{doc}       { allow read: if true; allow write: if isEditor(); }
    match /events/{doc}         { allow read: if true; allow write: if isEditor(); }
    match /equipmentNeeds/{doc} { allow read: if true; allow write: if isEditor(); }
    match /formations/{doc}     { allow read: if true; allow write: if isEditor(); }
    // Espaces partenaires multi-tenant (config de marque + contenu curé).
    match /tenants/{doc}        { allow read: if true; allow write: if isEditor(); }
    // Comités (gouvernance + indicateurs d'impact).
    match /committees/{doc}     { allow read: if true; allow write: if isEditor(); }

    // --- Site configuration (navigation menus, global settings) ---
    // Public read (header/footer render from it); admin-only writes.
    match /settings/{doc} { allow read: if true; allow write: if isAdmin(); }

    // --- Organizations / "pages" (Facebook/LinkedIn model) ---
    // Any active user creates a page they own; it starts 'pending' and only an
    // admin can flip its status. Owner/managers edit the profile but never the
    // status/owner. Public reads are limited to validated (active) pages.
    match /organizations/{org} {
      function orgData() { return resource.data; }
      function isManager() {
        return isSignedIn()
          && (request.auth.uid == orgData().ownerUid
              || request.auth.uid in orgData().managerUids);
      }

      allow read: if resource.data.status == 'active' || isManager() || isAdmin();

      allow create: if
        (isActiveUser()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.type in ['healthcare_facility', 'partner', 'partner_donor']
          && isText(request.resource.data.name, 2, 150))
        // Admins import directory listings (source:"imported", unowned, active).
        || (isAdmin()
          && request.resource.data.source == 'imported'
          && request.resource.data.type == 'healthcare_facility'
          && isText(request.resource.data.name, 2, 150));

      // Managers update profile fields but cannot self-validate, change owner,
      // nor grant themselves a paid tier — the monetization fields are written
      // exclusively by the subscription webhook (Admin SDK).
      allow update: if
        (isManager()
          && request.resource.data.status == resource.data.status
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.get('planTier', '') == resource.data.get('planTier', '')
          && request.resource.data.get('planId', '') == resource.data.get('planId', '')
          && request.resource.data.get('featured', false) == resource.data.get('featured', false)
          && request.resource.data.get('subscribedUntil', '') == resource.data.get('subscribedUntil', ''))
        || isAdmin();

      allow delete: if request.auth.uid == resource.data.ownerUid || isAdmin();
    }

    // --- Directory claim requests ---
    // An active user submits a claim for themselves on an imported page. Only an
    // admin reads the full queue / approves / rejects. The page's ownerUid and
    // claimStatus are changed via the organizations rules (admin-only), never here.
    match /claimRequests/{claim} {
      allow read: if isAdmin() || isOwner(resource.data.requesterUid);
      allow create: if isActiveUser()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && isText(request.resource.data.justification, 1, 2000);
      allow update, delete: if isAdmin();
    }

    // --- Demandes de vérification « professionnel de santé » ---
    // Un utilisateur actif crée SA demande ; un admin lit la file et décide.
    // Le passage au rôle `health_pro` se fait via la règle /users/{uid}
    // (roleChangeAuthorized, admin-only) lors de l'approbation.
    match /professionalVerificationRequests/{request} {
      allow read: if isAdmin() || isOwner(resource.data.requesterUid);
      allow create: if isActiveUser()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && isText(request.resource.data.justification, 1, 5000);
      allow update, delete: if isAdmin();
    }

    // --- Community content (active members can contribute) ---
    match /communities/{community} {
      allow read: if true;
      allow write: if isEditor();

      match /posts/{post} {
        allow read: if true;
        // Anti-impersonation: the author must be the signed-in active user.
        allow create: if isActiveUser()
          && request.resource.data.authorUid == request.auth.uid
          && isText(request.resource.data.content, 1, 5000);
        // Author edits own post; editors/admins moderate (delete) any post.
        allow update: if isOwner(resource.data.authorUid) || isAdmin();
        allow delete: if isOwner(resource.data.authorUid) || isEditor();
      }
    }

    match /forumThreads/{thread} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.authorUid == request.auth.uid
        && isText(request.resource.data.title, 1, 200)
        && isText(request.resource.data.excerpt, 1, 5000)
        && request.resource.data.kind in ['question', 'discussion', 'conseil'];
      // Author edits own thread; editors/admins moderate (delete) any thread.
      allow update: if isOwner(resource.data.authorUid) || isAdmin();
      allow delete: if isOwner(resource.data.authorUid) || isEditor();
    }

    // --- Private per-user collections (owner-only) ---
    // Dashboard data: favorites, saved searches, reminders, memberships.
    // NOTE: the match starts at a subcollection segment ({collection}/{doc})
    // so it can NEVER alias the profile document /users/{uid} itself —
    // otherwise this broad allow would override the role/status locking above
    // and let a user self-promote by writing their own profile doc.
    match /users/{uid}/{collection}/{doc=**} {
      allow read, write: if isOwner(uid);
    }

    // --- Private messaging (participants only) ---
    match /conversations/{conversation} {
      allow read, update, delete: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;

      match /messages/{message} {
        function convParticipants() {
          return get(/databases/$(database)/documents/conversations/$(conversation)).data.participants;
        }
        allow read: if isSignedIn() && request.auth.uid in convParticipants();
        allow create: if isSignedIn()
          && request.auth.uid in convParticipants()
          && request.resource.data.senderUid == request.auth.uid
          && isText(request.resource.data.text, 1, 5000);
      }
    }

    // --- Media library index (Firebase Storage holds the bytes) ---
    // Public read (URLs are surfaced on the site); editors/admins manage.
    match /media/{item} {
      allow read: if true;
      allow create: if isEditor()
        && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isEditor();
    }

    // --- Audit log (append-only, never mutated or deleted) ---
    // Any content/admin actor records an entry; only admins read the trail.
    match /auditLogs/{entry} {
      allow read: if isAdmin();
      allow create: if isEditor()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Donations (written exclusively by Cloud Functions / Admin SDK) ---
    // The payment flow runs server-side (createBictorysCharge + bictorysWebhook
    // use the Admin SDK, which bypasses these rules). Clients never write here;
    // a donor may read their own donations and admins read all (reconciliation).
    match /donations/{donation} {
      allow read: if isAdmin() || isOwner(resource.data.donorUid);
      allow write: if false;
    }

    // --- Monétisation (scaffold) ---
    // Plans tarifaires : grille publique (lecture), édition admin uniquement.
    match /pricingPlans/{plan} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registre transactionnel et reporting : écrits EXCLUSIVEMENT par les Cloud
    // Functions (Admin SDK, qui contourne ces règles). Le payeur lit ses propres
    // transactions ; les admins lisent tout pour la réconciliation/le dashboard.
    match /transactions/{txn} {
      allow read: if isAdmin() || isOwner(resource.data.payerUid);
      allow write: if false;
    }
    match /commissions/{commission} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /revenueReports/{report} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Abonnements : l'abonné lit le sien, l'owner de la page lit celui de sa page,
    // les admins lisent tout. Écriture serveur uniquement (Cloud Functions).
    match /subscriptions/{sub} {
      allow read: if isAdmin() || isOwner(resource.data.subscriberUid);
      allow write: if false;
    }

    // Charges en attente (abonnements/billets) : créées et finalisées par les
    // Cloud Functions uniquement ; le payeur peut relire la sienne.
    match /pendingCharges/{charge} {
      allow read: if isAdmin() || isOwner(resource.data.payerUid);
      allow write: if false;
    }

    // Billets d'événement : l'acheteur lit les siens ; écriture Functions only.
    match /tickets/{ticket} {
      allow read: if isAdmin() || isOwner(resource.data.buyerUid);
      allow write: if false;
    }

    // Campagnes de prévention (SMS/WhatsApp) : créées/envoyées par la Function
    // sendCampaign (Admin SDK) ; lecture admin pour le suivi.
    match /campaigns/{campaign} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- Capture d'engagement public (newsletter, intention de don) ---
    // Création ouverte (visiteur non connecté) mais shape validée et taille
    // bornée ; lecture réservée aux admins ; jamais de mutation/suppression.
    match /newsletterSignups/{signup} {
      allow read: if isAdmin();
      allow create: if isText(request.resource.data.email, 5, 200)
        && isText(request.resource.data.get('source', ''), 0, 60);
      allow update, delete: if false;
    }
    match /supportIntents/{intent} {
      allow read: if isAdmin();
      allow create: if isText(request.resource.data.email, 5, 200)
        && request.resource.data.monthlyAmount is number
        && request.resource.data.monthlyAmount >= 500
        && request.resource.data.monthlyAmount <= 5000000;
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
