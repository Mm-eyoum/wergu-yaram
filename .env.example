# Firebase — projet werguyaram
# Copier ce fichier en .env.local et renseigner les valeurs (console Firebase > Paramètres du projet).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Origine canonique du site (sans slash final), ex : https://werguyaram.org
# Utilisée pour les URLs absolues Open Graph / canonical / sitemap.
VITE_SITE_URL=https://werguyaram.org

# --- Sécurité : Firebase App Check (anti-abus) ---
# Protège Firestore/Storage/Functions contre les requêtes hors de la vraie app.
# Clé de site reCAPTCHA v3 (console Firebase > App Check > reCAPTCHA v3).
# Si vide, App Check est désactivé (dev/test continuent de fonctionner).
# Penser à activer l'« enforcement » dans la console une fois le client déployé.
VITE_APPCHECK_SITE_KEY=
# (Dev uniquement) jeton de debug App Check pour tester depuis une origine non
# enregistrée. Laisser vide en production.
VITE_APPCHECK_DEBUG_TOKEN=

# (Optionnel) Monitoring d'erreurs : Sentry (tier gratuit). Les erreurs sont aussi
# remontées vers Firebase Analytics (événements `exception`) ; renseigner le DSN
# ci-dessous active EN PLUS Sentry (sink composite, no-op si vide).
VITE_SENTRY_DSN=

# (Optionnel) Analytics produit : PostHog Cloud (tier gratuit). Complète GA4
# (session replay, funnels, feature flags). No-op si la clé est vide.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# (Optionnel) Compte admin utilisé par `npm run seed` pour écrire le contenu
# lorsque les règles strictes sont déjà déployées. Laisser vide si vous seedez
# en « test mode » avant le déploiement des règles. Ne PAS committer .env.local.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Recherche ---
# Backend : "local" (index Orama in-browser depuis /search-index.json, défaut, gratuit)
# ou "typesense" (Typesense Cloud, conservé en fallback).
VITE_SEARCH_BACKEND=local
#
# --- Recherche : Typesense Cloud (fallback, utilisé si VITE_SEARCH_BACKEND=typesense) ---
# Client (exposé au navigateur) : clé SEARCH-ONLY uniquement.
# Si non renseigné, la recherche retombe sur l'index local (mock).
# HOST = un nœud du cluster, ex : xxxxx-1.a1.typesense.net
VITE_TYPESENSE_HOST=
# NEAREST_HOST = endpoint "Nearest Node" du dashboard (SDN, latence min.) — optionnel
# ex : xxxxx.a1.typesense.net
VITE_TYPESENSE_NEAREST_HOST=
VITE_TYPESENSE_PORT=443
VITE_TYPESENSE_PROTOCOL=https
VITE_TYPESENSE_SEARCH_KEY=
VITE_TYPESENSE_COLLECTION=content
# Indexation (serveur uniquement, via `npm run typesense:index`) : clé ADMIN.
# Utiliser le HOST d'un nœud (pas le Nearest Node) pour les écritures.
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_ADMIN_KEY=
TYPESENSE_COLLECTION=content

# --- Support : Chatwoot (omnicanal, auto-hébergé) ---
# BASE_URL = URL de votre instance (ex : https://chat.werguyaram.org) ;
# TOKEN = Website Token de l'inbox "Website". Si non renseigné, le widget n'est
# pas chargé (CTA support → /messages). L'identité vérifiée (identifier_hash) est
# calculée par la Function `chatwootIdentity` (secret CHATWOOT_HMAC_TOKEN côté serveur).
# ⚠️ Si vous changez de domaine, alignez la CSP de firebase.json (chat.werguyaram.org).
VITE_CHATWOOT_BASE_URL=https://chat.werguyaram.org
VITE_CHATWOOT_WEBSITE_TOKEN=

# --- Paiement : Bictorys ---
# Active le don en ligne côté client (le client appelle la Function serveur).
VITE_BICTORYS_ENABLED=false
# Secrets SERVEUR (Firebase Functions, voir functions/.env) — JAMAIS côté client :
#   BICTORYS_API_KEY=          # clé secrète Bictorys
#   BICTORYS_API_URL=https://api.bictorys.com
#   BICTORYS_WEBHOOK_SECRET=   # vérification de signature du webhook
#   APP_PUBLIC_URL=https://werguyaram.org

# --- Développement local : émulateurs Firebase ---
# Mettre à true pour router auth/firestore/functions/storage vers les émulateurs
# locaux (`firebase emulators:start`). Permet de tester searchPlaces/importPlaces
# et les Functions sans déployer. Laisser vide/false en production.
VITE_USE_EMULATORS=false

# --- Annuaire : source d'import (admin) ---
# "osm" (Overpass API OpenStreetMap, gratuit sans clé, défaut) ou "google"
# (Places API, conservé en fallback). En mode osm, VITE_PLACES_API_KEY est ignorée.
VITE_DIRECTORY_SOURCE=osm
#
# --- Annuaire : import Google Places (admin, fallback si VITE_DIRECTORY_SOURCE=google) ---
# Carto affichée = OpenStreetMap (gratuit, sans clé). L'import admin appelle
# l'API Places (New) directement depuis le navigateur. La clé est dans le bundle
# client (modèle standard des clés Maps) : la RESTREINDRE dans Google Cloud à
#   - Référents HTTP : https://werguyaram.org/*, https://*.web.app/*, http://localhost:*
#   - API : "Places API (New)" uniquement
# et activer "Places API (New)" dans la console.
VITE_PLACES_API_KEY=
